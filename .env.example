# Deployment settings for deploy.sh — copy to .env (gitignored) and edit.
#
# deploy.sh sources .env as a shell script. The ${VAR:-value} form means an
# environment variable set on the command line still wins, e.g.
# `PORT=8080 ./deploy.sh`.

# SSH host to deploy to: a Host alias from ~/.ssh/config or user@hostname.
DEPLOY_HOST="${DEPLOY_HOST:-your-docker-host}"

# Host port to publish (default: 5567).
#PORT="${PORT:-5567}"

# Image name (default: renovatie).
#IMAGE="${IMAGE:-renovatie}"
